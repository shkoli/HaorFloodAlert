# Copy this file to .env and fill in real values. Never commit .env.

# Gmail SMTP alert sender (optional — used for community flood alert emails)
# Generate an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the sending Google account)
ALERT_EMAIL_SENDER=your_email@gmail.com
ALERT_EMAIL_RECIPIENT=recipient_email@gmail.com
ALERT_APP_PASSWORD=xxxx xxxx xxxx xxxx

# BulkSMSBD SMS gateway (optional — used by streamlit_app/pages/3_Alerts.py)
# Get an API key at http://bulksmsbd.net -> My Account -> API Keys
BULKSMS_API_KEY=
BULKSMS_SENDER_ID=
